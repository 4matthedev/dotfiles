/* ==========================================
   ROFI — MAIN CONFIGURATION
   Theme: nord.rasi (Nord palette)
   Launcher: SUPER + D
   ========================================== */

@import "nord.rasi"

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    terminal:            "kitty";

    drun-display-format: "{name}";
    display-drun:        "  Apps";
    display-run:         "  Run";
    display-window:      "  Windows";

    font:                "JetBrainsMono Nerd Font 11";
}
